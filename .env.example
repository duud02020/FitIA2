# ==============================================================================
# FIT.IA - CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================

# Servidor e Porta
PORT=3000
NODE_ENV=development

# Autenticação JWT e Segurança
JWT_SECRET=fitia_jwt_secret_key_super_segura_2026_fitness_app
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Provedor de IA ('gemini' ou 'openai')
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Chaves de API das LLMs (Insira a sua chave para ativar inteligência artificial em tempo real)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# Conexão de Banco de Dados (Opcional - usa persistência local em data/ por padrão)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/fitia_db?schema=public
